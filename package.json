{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Supabase Edge Functions Backend with TypeScript",
  "scripts": {
    "dev": "deno run --allow-all --node-modules-dir=none dev-server.ts",
    "start": "deno run --allow-all --node-modules-dir=none dev-server.ts",
    "test": "vitest run",
    "functions:serve": "supabase functions serve --no-verify-jwt",
    "functions:new": "supabase functions new",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "deno": "^2.9.6",
    "supabase": "^3.2.0",
    "vitest": "^4.1.12"
  }
}
